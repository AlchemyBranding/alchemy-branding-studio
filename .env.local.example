# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Resend (contact form: emails hello@, which Opus reads into Enquiries)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Newsletter and checklist sign-up -> Opus (POST /api/newsletter-signup).
# The same key is set in the Opus Vercel project. Never print it. Without it, production
# shows an error rather than pretending; local development simulates.
NEWSLETTER_SIGNUP_KEY=
# Optional: another Opus address (e.g. a preview). Defaults to https://opus.alchemybranding.studio/api/newsletter-signup
OPUS_NEWSLETTER_SIGNUP_URL=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-KLKH973

# External services
NEXT_PUBLIC_BOOKING_URL=https://opus.alchemybranding.studio/book/clarity-call?utm_source=website
NEXT_PUBLIC_WHATSAPP_NUMBER=447734794779

# Environment flag (production | staging | development)
# Controls robots.txt allow/disallow
NEXT_PUBLIC_ENV=development
